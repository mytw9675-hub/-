}

function openAdhkarCategory(id) {
    const c = adhkarCategories.find(x => x.id === id);
    document.getElementById('adhkarDetailTitle').textContent = c.title;
    const el = document.getElementById('adhkarDetailList');
    el.innerHTML = '';
    
    (adhkarData[id] || []).forEach(a => {
        const d = document.createElement('div');
        d.className = 'dhikr-card';
        d.innerHTML = `
            <div class="dhikr-text">${a.t}</div>
            <div class="dhikr-meta"><span class="count-pill">التكرار: ${a.n}</span><span>المصدر: ${a.s}</span></div>
            <div class="counter">
                <button class="count-btn">تسبيح</button><strong class="count-val">0</strong><button class="reset-btn reset">إعادة</button>
            </div>
        `;
        let current = 0;
        const btn = d.querySelector('.count-btn'), val = d.querySelector('.count-val'), reset = d.querySelector('.reset-btn');
        btn.onclick = () => { if (current < a.n) current++; val.textContent = current; if (current === a.n) btn.textContent = 'اكتمل ✓'; };
        reset.onclick = () => { current = 0; val.textContent = '0'; btn.textContent = 'تسبيح'; };
        el.appendChild(d);
    });
    showPage('adhkarDetail');
}

