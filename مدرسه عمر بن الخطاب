<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0a192f">
<title>موقع عمر بن الخطاب - القرآن والأذكار</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
    --bg: #0a192f;
    --bg-gradient: linear-gradient(135deg, #0a192f, #112240, #0d2b45);
    --panel: rgba(23, 42, 69, 0.85);
    --panel-border: rgba(255, 255, 255, 0.1);
    --gold: #d4af37;
    --gold-light: #f3e5ab;
    --text: #e6f1ff;
    --muted: #8892b0;
    --green: #64ffda;
    --shadow: 0 10px 30px -15px rgba(2, 12, 27, 0.7);
    
    /* ألوان المصحف */
    --mushaf-bg: #fdfaf6;
    --mushaf-text: #222;
    --mushaf-border: #b08d57;
    --mushaf-primary: #2e7d32;
}

* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Tajawal', Tahoma, sans-serif; }
body {
    background: var(--bg-gradient);
    color: var(--text);
    line-height: 1.8;
    overflow-x: hidden;
    min-height: 100vh;
}

/* --- الخلفية المتحركة --- */
.waves-container { position: fixed; bottom: 0; left: 0; width: 100%; height: 100%; z-index: -2; overflow: hidden; }
.wave {
    position: absolute; bottom: 0; left: 0; width: 200%; height: 100%;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23112240" fill-opacity="0.4" d="M0,224L48,213.3C96,203,192,181,288,181.3C384,181,480,203,576,224C672,245,768,267,864,250.7C960,235,1056,181,1152,165.3C1248,149,1344,171,1392,181.3L1440,192L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>');
    background-size: 50% 100%; animation: wave-animation 15s linear infinite; opacity: 0.5;
}
.wave:nth-child(2) {
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%230d2b45" fill-opacity="0.6" d="M0,192L48,176C96,160,192,128,288,128C384,128,480,160,576,192C672,224,768,256,864,250.7C960,245,1056,203,1152,192C1248,181,1344,203,1392,213.3L1440,224L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>');
    background-size: 100% 100%; animation: wave-animation 10s linear infinite reverse; opacity: 0.3;
}
@keyframes wave-animation { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
.stars {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;
    background-image: radial-gradient(1px 1px at 10% 20%, white, transparent), radial-gradient(1.5px 1.5px at 30% 60%, rgba(255, 255, 255, 0.7), transparent), radial-gradient(2px 2px at 70% 30%, white, transparent), radial-gradient(1px 1px at 80% 80%, rgba(255, 255, 255, 0.5), transparent);
    background-size: 200px 200px; animation: twinkle 4s infinite alternate;
}
@keyframes twinkle { 0% { opacity: 0.3; } 100% { opacity: 0.8; } }

/* --- الهيدر والتنقل --- */
header { background: rgba(10, 25, 47, 0.85); backdrop-filter: blur(10px); border-bottom: 1px solid var(--panel-border); position: sticky; top: 0; z-index: 100; }
.top { max-width: 1150px; margin: auto; padding: 15px 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
.brand { display: flex; align-items: center; gap: 12px; font-size: 22px; font-weight: bold; color: var(--gold-light); }
.brand .mark { width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, var(--gold), #b8860b); color: #0a192f; display: grid; place-items: center; font-size: 24px; box-shadow: 0 0 15px rgba(212, 175, 55, 0.4); }
nav { display: flex; gap: 8px; flex-wrap: wrap; }
.navbtn { background: transparent; color: var(--text); border: 1px solid var(--panel-border); padding: 8px 16px; border-radius: 10px; cursor: pointer; transition: 0.3s; font-size: 15px; }
.navbtn:hover { background: rgba(212, 175, 55, 0.1); border-color: var(--gold); }
.navbtn.active { background: linear-gradient(135deg, var(--gold), #b8860b); color: #0a192f; font-weight: bold; border-color: transparent; }

/* --- المحتوى الرئيسي --- */
main { max-width: 1150px; margin: 30px auto; padding: 0 20px; }
.page { display: none; animation: fadeIn 0.5s ease; }
.page.active { display: block; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

/* --- البطاقة الرئيسية --- */
.hero { background: linear-gradient(120deg, rgba(23, 42, 69, 0.8), rgba(13, 43, 69, 0.9)); border: 1px solid var(--panel-border); border-radius: 24px; padding: 40px; position: relative; overflow: hidden; box-shadow: var(--shadow); text-align: center; }
.hero::before { content: "۞"; position: absolute; font-size: 250px; color: var(--gold); opacity: 0.05; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none; }
.hero h1 { font-size: clamp(28px, 5vw, 42px); margin-bottom: 15px; color: var(--gold-light); }
.hero p { font-size: 18px; color: var(--muted); margin-bottom: 25px; max-width: 600px; margin-left: auto; margin-right: auto; }
.hero button { padding: 14px 28px; border-radius: 12px; background: linear-gradient(135deg, var(--gold), #b8860b); color: #0a192f; font-weight: bold; font-size: 16px; border: none; cursor: pointer; transition: 0.3s; box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3); }
.hero button:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(212, 175, 55, 0.4); }

/* --- شبكة البطاقات --- */
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 30px; }
.tile { background: var(--panel); border: 1px solid var(--panel-border); border-radius: 20px; padding: 25px; cursor: pointer; transition: 0.3s; text-align: center; backdrop-filter: blur(10px); }
.tile:hover { transform: translateY(-5px); border-color: var(--gold); box-shadow: var(--shadow); }
.tile .ico { font-size: 40px; margin-bottom: 10px; }
.tile h3 { color: var(--gold-light); font-size: 20px; margin-bottom: 5px; }

/* --- الأقسام الداخلية --- */
.section { background: var(--panel); border: 1px solid var(--panel-border); border-radius: 20px; padding: 25px; margin-bottom: 25px; backdrop-filter: blur(10px); box-shadow: var(--shadow); }
.section h2 { color: var(--gold); margin-bottom: 15px; font-size: 24px; }
.section-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-bottom: 20px; }
.search { width: 100%; background: rgba(10, 25, 47, 0.6); border: 1px solid var(--panel-border); border-radius: 12px; padding: 12px 15px; color: var(--text); outline: none; transition: 0.3s; margin-bottom: 15px; font-family: 'Tajawal', sans-serif; }
.search:focus { border-color: var(--gold); box-shadow: 0 0 10px rgba(212, 175, 55, 0.2); }

/* --- قائمة السور (الرئيسية) --- */
.surah-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
.surah { background: rgba(23, 42, 69, 0.5); border: 1px solid var(--panel-border); border-radius: 12px; padding: 12px; display: flex; align-items: center; gap: 12px; cursor: pointer; transition: 0.3s; text-align: right; color: var(--text); }
.surah:hover { border-color: var(--gold); background: rgba(212, 175, 55, 0.1); }
.num { width: 36px; height: 36px; border-radius: 10px; background: rgba(212, 175, 55, 0.15); color: var(--gold-light); display: grid; place-items: center; font-weight: bold; flex-shrink: 0; }

/* --- الأذكار --- */
.adhkar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 15px; }
.adhkar-card { background: var(--panel); border: 1px solid var(--panel-border); border-radius: 16px; overflow: hidden; cursor: pointer; transition: 0.3s; }
.adhkar-card:hover { transform: translateY(-5px); border-color: var(--gold); }
.adhkar-cover { height: 120px; display: grid; place-items: center; font-size: 50px; background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(100, 255, 218, 0.05)); border-bottom: 1px solid var(--panel-border); }
.adhkar-card-body { padding: 15px; text-align: center; }
.adhkar-card-body h3 { color: var(--gold-light); font-size: 18px; }
.dhikr-card { background: rgba(23, 42, 69, 0.4); border: 1px solid var(--panel-border); border-radius: 16px; padding: 20px; margin-bottom: 15px; }
.dhikr-text { font-family: 'Amiri Quran', serif; font-size: 24px; text-align: center; color: var(--gold-light); margin-bottom: 15px; }
.dhikr-meta { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; font-size: 13px; color: var(--muted); margin-bottom: 15px; }
.count-pill { background: rgba(100, 255, 218, 0.1); color: var(--green); padding: 4px 12px; border-radius: 20px; border: 1px solid rgba(100, 255, 218, 0.2); }
.counter { display: flex; justify-content: center; align-items: center; gap: 15px; margin-top: 10px; }
.counter button { background: linear-gradient(135deg, var(--gold), #b8860b); color: #0a192f; border: none; padding: 8px 20px; border-radius: 8px; cursor: pointer; font-weight: bold; transition: 0.3s; }
.counter button:hover { opacity: 0.9; }
.counter .reset { background: rgba(255, 255, 255, 0.1); color: var(--text); border: 1px solid var(--panel-border); }
.counter strong { font-size: 22px; color: var(--gold-light); min-width: 30px; text-align: center; }

/* --- الفوتر --- */
footer { text-align: center; padding: 30px; margin-top: 50px; border-top: 1px solid var(--panel-border); background: rgba(10, 25, 47, 0.8); }
.developer-footer { display: inline-flex; align-items: center; gap: 15px; background: rgba(255, 255, 255, 0.05); padding: 15px 25px; border-radius: 16px; margin-bottom: 20px; }
.developer-contact { color: var(--green); text-decoration: none; border: 1px solid var(--green); padding: 8px 15px; border-radius: 8px; transition: 0.3s; }
.developer-contact:hover { background: rgba(100, 255, 218, 0.1); }
.footer-bottom { color: var(--muted); font-size: 13px; margin-top: 10px; }

/* --- شاشة المصحف --- */
#mushafScreen { display: none; background: var(--mushaf-bg); min-height: 100vh; color: var(--mushaf-text); position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 200; overflow-y: auto; }
.mushaf-header { position: sticky; top: 0; background: rgba(255,255,255,0.95); border-bottom: 1px solid #ddd; padding: 15px 20px; display: flex; align-items: center; justify-content: space-between; z-index: 10; }
.back-btn { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--mushaf-primary); font-weight: bold; }
.mushaf-title { font-size: 20px; font-weight: bold; color: var(--mushaf-text); }
.mushaf-container { max-width: 900px; margin: 20px auto; padding: 10px; }
.mushaf-frame { border: 6px double var(--mushaf-border); border-radius: 10px; padding: 30px 20px; background: #fffdf8; position: relative; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
.mushaf-frame::before { content: "۞"; position: absolute; top: 10px; left: 10px; font-size: 30px; color: var(--mushaf-border); opacity: 0.5; }
.mushaf-frame::after { content: "۞"; position: absolute; bottom: 10px; right: 10px; font-size: 30px; color: var(--mushaf-border); opacity: 0.5; }
.surah-title-mushaf { text-align: center; font-family: 'Amiri Quran', serif; font-size: 32px; color: #333; margin-bottom: 20px; border-bottom: 1px solid #ddd; padding-bottom: 10px; }
.basmala { text-align: center; font-family: 'Amiri Quran', serif; font-size: 28px; margin-bottom: 20px; }
.ayah-text { font-family: 'Amiri Quran', serif; font-size: 28px; line-height: 2.5; text-align: justify; direction: rtl; display: inline; }
.ayah-number { display: inline-flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 50%; border: 1px solid var(--mushaf-border); background: var(--mushaf-bg); font-family: 'Tajawal', sans-serif; font-size: 14px; margin: 0 5px; vertical-align: middle; }
.audio-player-wrapper { position: fixed; bottom: 20px; left: 20px; right: 20px; max-width: 800px; margin: auto; background: #fff; border-radius: 50px; padding: 10px 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.15); display: flex; align-items: center; gap: 15px; border: 1px solid #ddd; z-index: 300; }
.audio-player-wrapper audio { width: 100%; height: 40px; }
.reciter-select { padding: 8px; border-radius: 8px; border: 1px solid #ddd; background: #fff; font-family: 'Tajawal', sans-serif; outline: none; }

/* --- شاشة التحميل --- */
.loading { text-align: center; padding: 50px; font-size: 18px; color: var(--gold); }

/* --- استجابة الهواتف --- */
@media (max-width: 600px) {
    .top { flex-direction: column; align-items: flex-start; }
    nav { width: 100%; justify-content: center; }
    .navbtn { flex: 1; text-align: center; padding: 8px 5px; font-size: 13px; }
    .hero { padding: 25px; }
    .mushaf-frame { padding: 15px 10px; }
    .ayah-text { font-size: 24px; }
    .audio-player-wrapper { flex-direction: column; border-radius: 20px; padding: 15px; bottom: 10px; }
}
</style>
</head>
<body>

<!-- خلفية الأمواج والنجوم -->
<div class="waves-container"><div class="wave"></div><div class="wave"></div></div>
<div class="stars"></div>

<!-- الهيدر -->
<header>
    <div class="top">
        <div class="brand"><span class="mark">۞</span><span>عمر بن الخطاب</span></div>
        <nav>
            <button class="navbtn active" data-page="home">الرئيسية</button>
            <button class="navbtn" data-page="quran">القرآن الكريم</button>
            <button class="navbtn" data-page="hadith">الأحاديث</button>
            <button class="navbtn" data-page="adhkar">الأذكار</button>
        </nav>
    </div>
</header>

<!-- المحتوى -->
<main>
    <!-- الرئيسية -->
    <section id="home" class="page active">
        <div class="hero">
            <h1 id="heroTitle">موقع عمر بن الخطاب رضي الله عنه</h1>
            <p id="heroText">القرآن الكريم تلاوةً وتدبرًا، والأحاديث النبوية، وموسوعة الأذكار.</p>
            <button onclick="showPage('quran')">ابدأ القراءة ←</button>
        </div>
        
        <!-- معرض الصور (الذي يفتح المصحف) -->
        <div class="section">
            <div class="section-head">
                <h2>🖼️ قرأت مؤخراً</h2>
                <span class="muted">اضغط لفتح المصحف</span>
            </div>
            <div id="recentCards" style="display: flex; gap: 15px; overflow-x: auto; padding-bottom: 10px;">
                <!-- سيتم ملؤها ديناميكياً -->
            </div>
        </div>

        <div class="grid">
            <div class="tile" onclick="showPage('quran')"><div class="ico">📖</div><h3>القرآن الكريم</h3><div class="muted">السور والآيات والقراءة</div></div>
            <div class="tile" onclick="showPage('hadith')"><div class="ico">📚</div><h3>الأحاديث النبوية</h3><div class="muted">أحاديث مع مصادرها</div></div>
            <div class="tile" onclick="showPage('adhkar')"><div class="ico">🤲</div><h3>الأذكار</h3><div class="muted">أذكار الصباح والمساء</div></div>
        </div>
    </section>

    <!-- القرآن -->
    <section id="quran" class="page">
        <div class="section">
            <div class="section-head"><h2>📖 قائمة السور</h2><span class="muted" id="apiStatus">تحميل...</span></div>
            <input class="search" id="surahSearch" placeholder="ابحث عن سورة...">
            <div class="surah-list" id="surahList"><p class="muted">جارٍ التحميل...</p></div>
        </div>
    </section>

    <!-- الأحاديث -->
    <section id="hadith" class="page">
        <div class="section">
            <div class="section-head"><h2>📚 أحاديث نبوية</h2></div>
            <input class="search" id="hadithSearch" placeholder="ابحث في الأحاديث...">
            <div id="hadithList"></div>
        </div>
    </section>

    <!-- الأذكار -->
    <section id="adhkar" class="page">
        <div class="section">
            <div class="section-head"><h2>🤲 موسوعة الأذكار</h2></div>
            <div id="adhkarCategories" class="adhkar-grid"></div>
        </div>
    </section>
    
    <!-- تفاصيل الأذكار -->
    <section id="adhkarDetail" class="page">
        <div class="section">
            <div class="section-head">
                <button class="navbtn" onclick="showPage('adhkar')">← رجوع</button>
                <h2 id="adhkarDetailTitle">الأذكار</h2>
            </div>
            <div id="adhkarDetailList"></div>
        </div>
    </section>
</main>

<!-- شاشة المصحف المنبثقة (تفتح كصفحة كاملة) -->
<div id="mushafScreen">
    <div class="mushaf-header">
        <button class="back-btn" onclick="closeMushaf()">→ رجوع</button>
        <div class="mushaf-title" id="mushafHeaderTitle">المصحف</div>
        <div style="width: 60px;"></div>
    </div>
    
    <div class="mushaf-container">
        <div class="mushaf-frame">
            <div class="surah-title-mushaf" id="mushafTitle">سورة</div>
            <div class="basmala" id="mushafBasmala">بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ</div>
            <div id="mushafText"></div>
        </div>
    </div>

    <!-- المشغل -->
    <div class="audio-player-wrapper">
        <select class="reciter-select" id="reciterSelect" onchange="changeReciter()">
            <option value="ar.alafasy">مشاري العفاسي</option>
            <option value="ar.abdulbasitmurattal">عبد الباسط عبد الصمد</option>
            <option value="ar.mahermuaiqly">ماهر المعيقلي</option>
            <option value="ar.husary">محمود خليل الحصري</option>
        </select>
        <audio id="audioPlayer" controls></audio>
    </div>
</div>

<!-- الفوتر -->
<footer>
    <div class="developer-footer">
        <div>👨‍💻</div>
        <div><b>تطوير الموقع</b><br><span>ميثاق البار باموس</span></div>
        <a href="https://wa.me/967780538971" target="_blank" class="developer-contact">تواصل عبر واتساب</a>
    </div>
    <div class="footer-bottom">موقع عمر بن الخطاب رضي الله عنه</div>
</footer>

<script>
// --- التنقل بين الصفحات ---
const pages = ['home', 'quran', 'hadith', 'adhkar', 'adhkarDetail'];
function showPage(id) {
    pages.forEach(p => document.getElementById(p).classList.toggle('active', p === id));
    document.querySelectorAll('.navbtn').forEach(b => b.classList.toggle('active', b.dataset.page === id));
    window.scrollTo({ top: 0, behavior: 'smooth' });
}
document.querySelectorAll('.navbtn').forEach(b => b.addEventListener('click', () => showPage(b.dataset.page)));

// --- متغيرات المصحف ---
let surahsData = [];
let currentSurah = null;

// --- جلب السور ---
async function loadSurahs() {
    try {
        const r = await fetch('https://api.alquran.cloud/v1/surah');
        const j = await r.json();
        surahsData = j.data;
        document.getElementById('apiStatus').textContent = '114 سورة';
        drawSurahs(surahsData);
        renderRecentCards();
    } catch (e) {
        document.getElementById('surahList').innerHTML = '<p class="muted">تعذر التحميل. تحقق من الإنترنت.</p>';
    }
}

function drawSurahs(arr) {
    const list = document.getElementById('surahList');
    list.innerHTML = '';
    arr.forEach(s => {
        const b = document.createElement('button');
        b.className = 'surah';
        b.innerHTML = `<span class="num">${s.number}</span><span><b>${s.name}</b><br><small class="muted">${s.numberOfAyahs} آية</small></span>`;
        b.onclick = () => openMushaf(s.number);
        list.appendChild(b);
    });
}

document.getElementById('surahSearch').addEventListener('input', e => {
    const q = e.target.value.trim().toLowerCase();
    drawSurahs(surahsData.filter(s => s.name.includes(q) || String(s.number) === q));
});

// --- بطاقات "قرأت مؤخراً" ---
function renderRecentCards() {
    const container = document.getElementById('recentCards');
    container.innerHTML = '';
    // نجلب أول 3 سور كبطاقات (يمكنك تعديلها لاحقاً)
    const recent = surahsData.slice(0, 3);
    recent.forEach(s => {
        const div = document.createElement('div');
        div.style.cssText = 'min-width: 180px; background: rgba(23, 42, 69, 0.6); border: 1px solid var(--panel-border); border-radius: 12px; padding: 15px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: 0.3s;';
        div.onmouseover = () => div.style.borderColor = 'var(--gold)';
        div.onmouseout = () => div.style.borderColor = 'var(--panel-border)';
        div.onclick = () => openMushaf(s.number);
        div.innerHTML = `
            <div>
                <h4 style="color: var(--gold-light); margin-bottom: 5px;">${s.name}</h4>
                <span style="font-size: 12px; color: var(--muted);">${s.numberOfAyahs} آية</span>
            </div>
            <div style="color: var(--gold); font-size: 20px;">›</div>
        `;
        container.appendChild(div);
    });
}

// --- فتح المصحف (شاشة كاملة) ---
async function openMushaf(surahNumber) {
    document.getElementById('mushafScreen').style.display = 'block';
    document.getElementById('mushafText').innerHTML = '<div class="loading">جارٍ تحميل الآيات...</div>';
    
    const meta = surahsData.find(s => s.number === surahNumber);
    document.getElementById('mushafHeaderTitle').textContent = meta.name;
    document.getElementById('mushafTitle').textContent = meta.name;
    document.getElementById('mushafBasmala').style.display = surahNumber === 9 ? 'none' : 'block';

    try {
        // استخدام الخط العثماني
        const r = await fetch(`https://api.alquran.cloud/v1/surah/${surahNumber}/quran-uthmani`);
        const j = await r.json();
        const ayahs = j.data.ayahs;
        
        let html = '';
        ayahs.forEach(a => {
            let text = a.text;
            if (surahNumber !== 1 && a.numberInSurah === 1) {
                text = text.replace('بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ', '');
            }
            html += `<span class="ayah-text">${text}</span> <span class="ayah-number">${a.numberInSurah}</span> `;
        });
        
        document.getElementById('mushafText').innerHTML = html;
        setupAudio(surahNumber);
        localStorage.setItem('lastSurah', surahNumber); // حفظ آخر سورة
        
    } catch (e) {
        document.getElementById('mushafText').innerHTML = '<div class="loading">تعذر تحميل الآيات.</div>';
    }
}

function closeMushaf() {
    document.getElementById('mushafScreen').style.display = 'none';
    document.getElementById('audioPlayer').pause();
}

// --- إعداد الصوت ---
function setupAudio(surahNumber) {
    currentSurah = surahNumber;
    const reciter = document.getElementById('reciterSelect').value;
    const audio = document.getElementById('audioPlayer');
    audio.src = `https://cdn.islamic.network/quran/audio-surah/128/${reciter}/${surahNumber}.mp3`;
    audio.load();
    audio.play().catch(() => console.log("انقر على زر التشغيل إذا لم يبدأ الصوت."));
}

function changeReciter() {
    if (currentSurah) setupAudio(currentSurah);
}

